---
import DotGrid from '../decor/DotGrid.astro';
import Arcs from '../decor/Arcs.astro';
import { clients } from '../../data/site';
import { yearsSinceYear } from '../../lib/years';

// Bars are relative to the longest partnership; order and proportions only change on rebuild,
// while the numbers themselves are refreshed in the browser (scripts/years.ts).
const sorted = clients
  .map((c) => ({ ...c, years: yearsSinceYear(c.since) }))
  .sort((a, b) => b.years - a.years || a.name.localeCompare(b.name, 'es'));
const max = sorted[0].years;
---
<section class="section clients" id="clientes" aria-labelledby="clients-title">
  <DotGrid class="clients__dots" cols={8} rows={5} />
  <Arcs class="clients__arcs" rings={4} sweep={200} />
  <div class="container">
    <div class="section-head clients__head">
      <h2 id="clients-title" data-reveal>Algunos de nuestros clientes</h2>
      <p class="lede" data-reveal style="--i:1">
        Empresas e instituciones que confían en nosotros, algunas desde hace más de tres décadas.
        Ordenados por años de alianza.
      </p>
    </div>

    <ul class="clients__list">
      {sorted.map((c, i) => (
        <li class="client" data-reveal="fade" style={`--i:${i % 2};--w:${(c.years / max).toFixed(3)}`}>
          <div class="client__info">
            <h3>{c.name}</h3>
            <p>{c.sector}</p>
          </div>
          <div class="client__years">
            <span class="client__num" title={`Desde ${c.since}`}><span data-years-since-year={c.since}>{c.years}</span> {c.years === 1 ? 'año' : 'años'}</span>
            <span class="client__bar" aria-hidden="true"><span></span></span>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .clients { overflow: clip; background: var(--green-50); }
  :global(.clients__arcs) { width: 420px; left: -290px; bottom: -250px; color: var(--green-500); opacity: 0.6; }
  :global(.clients__dots) { right: max(1rem, calc(50% - 680px)); top: 4rem; }
  .clients__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--green-100);
  }
  .client {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 7.5rem;
    gap: 1.25rem;
    align-items: center;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--green-100);
  }
  .client__info { display: grid; gap: 0.2rem; }
  .client h3 { font-size: 1.0625rem; color: var(--ink); line-height: 1.35; }
  .client p { font-size: var(--step--1); color: var(--ink-muted); line-height: 1.45; }

  .client__years { display: grid; gap: 0.45rem; justify-items: start; }
  .client__num { font-weight: 700; color: var(--green-800); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .client__bar { width: 100%; height: 4px; border-radius: 4px; background: var(--white); overflow: hidden; }
  .client__bar span {
    display: block; height: 100%;
    width: calc(var(--w) * 100%);
    background: var(--green-500);
    border-radius: 4px;
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .client__bar span { transform: scaleX(0); transition: transform 1.1s var(--ease-out) 250ms; }
    :global(.js) .client:global(.is-visible) .client__bar span { transform: scaleX(1); }
  }

  @media (max-width: 859px) {
    .clients__list { grid-template-columns: 1fr; }
    :global(.clients__dots) { display: none; }
  }
  @media (max-width: 419px) {
    .client { grid-template-columns: minmax(0, 1fr) 5.5rem; gap: 0.85rem; }
  }
</style>
