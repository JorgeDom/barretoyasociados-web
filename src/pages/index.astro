---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import About from '../components/About.astro';
import Team from '../components/Team.astro';
import Clients from '../components/Clients.astro';
import StatsCta from '../components/StatsCta.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFab from '../components/WhatsAppFab.astro';
---

<Base
  title="Barreto y Asociados | Agencia de Despachos Aduaneros en Asunción"
  description="Agencia de despachos aduaneros en Asunción con 43 años de trayectoria. Despacho de aduanas, asesoría en legislación aduanera, maquila, incentivos fiscales (Ley 60/90) y gestión ante instituciones públicas."
>
  <div class="relative overflow-x-hidden bg-white text-ink">
    <Header />
    <main>
      <Hero />
      <div class="mx-auto max-w-[1240px] px-5 wide:max-w-[1760px] ultra:max-w-[2200px]">
        <Services />
        <About />
        <Team />
        <Clients />
        <StatsCta />
        <Contact />
      </div>
    </main>
    <Footer />
    <WhatsAppFab />
  </div>
</Base>
