---
import Media from '../ui/Media.astro';
import Glow from '../decor/Glow.astro';
import { team, teamIntro } from '../../data/site';
---
<section class="section team" id="equipo" aria-labelledby="team-title">
  <Glow class="team__glow" />
  <div class="container">
    <div class="section-head">
      <h2 id="team-title" data-reveal>Conozca al equipo</h2>
      <p class="lede" data-reveal style="--i:1">{teamIntro}</p>
    </div>

    <ul class="team__grid">
      {team.map((m, i) => (
        <li class="member" data-reveal style={`--i:${i % 3}`}>
          <div class="member__photo">
            <Media file={m.photo} alt={`Retrato de ${m.name}`} width={800} height={1000} />
          </div>
          <h3>{m.name}</h3>
          <p>{m.role}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .team { overflow: clip; }
  :global(.team__glow) { left: -220px; top: 30%; width: 640px; height: 640px; }
  .team__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 1040px;
    gap: clamp(2rem, 4vw, 3.5rem) clamp(1.25rem, 3vw, 2.5rem);
  }
  .member { display: grid; gap: 0.35rem; }
  .member__photo {
    margin-bottom: 1rem;
    overflow: hidden;
    border-radius: var(--radius-m) 120px var(--radius-m) var(--radius-m);
    background: var(--green-50);
  }
  .member__photo :global(img) { transition: transform 600ms var(--ease-out); }
  .member:hover .member__photo :global(img) { transform: scale(1.03); }
  .member h3 { color: var(--ink); }
  .member p { color: var(--green-800); font-weight: 500; }

  @media (max-width: 859px) { .team__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 479px) {
    .member__photo { border-radius: var(--radius-s) 64px var(--radius-s) var(--radius-s); margin-bottom: 0.6rem; }
    .member h3 { font-size: 1rem; }
    .member p { font-size: var(--step--1); }
  }
</style>
