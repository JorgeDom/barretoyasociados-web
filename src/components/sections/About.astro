---
import Media from '../ui/Media.astro';
import Arcs from '../decor/Arcs.astro';
import { about } from '../../data/site';
---
<section class="section about" id="nosotros" aria-labelledby="about-title">
  <div class="container">
    <div class="about__grid">
      <div class="about__copy">
        <h2 id="about-title" data-reveal>Quiénes somos</h2>
        <div class="prose about__prose">
          {about.paragraphs.map((p, i) => <p data-reveal style={`--i:${i + 1}`}>{p}</p>)}
        </div>
      </div>
      <div class="about__visual" data-reveal="fade">
        <Arcs class="about__arcs" rings={3} sweep={160} />
        <div class="about__frame">
          <Media file="about-document.jpg" alt="Equipo de la agencia revisando documentación de una operación, con el puerto de fondo" width={1200} height={900} />
        </div>
      </div>
    </div>

    <dl class="stats">
      {about.stats.map((s, i) => (
        <div class="stats__item" data-reveal style={`--i:${i}`}>
          <dt class="stats__label">{s.label}</dt>
          <dd class="stats__value">
            {s.plain ? (
              <span>{s.value}</span>
            ) : (
              <span data-count={s.value}>{s.value}</span>
            )}
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .about__copy { display: grid; gap: 1.75rem; }
  .about__prose { font-size: var(--step-1); line-height: 1.6; }
  .about__prose p:last-child { color: var(--ink-muted); font-size: var(--step-0); }

  .about__visual { position: relative; max-width: 580px; justify-self: end; width: 100%; }
  .about__frame {
    border-radius: var(--radius-l) var(--radius-l) var(--radius-l) 160px;
    overflow: hidden;
  }
  :global(.about__arcs) { width: 320px; left: -110px; bottom: -170px; color: var(--green-500); }

  .stats {
    margin: clamp(4rem, 8vw, 6.5rem) 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--gray-100);
  }
  .stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding: 2rem clamp(1rem, 3vw, 2.5rem) 0;
    border-left: 1px solid var(--gray-100);
  }
  .stats__item:first-child { border-left: 0; padding-left: 0; }
  .stats__value {
    margin: 0;
    font-size: clamp(3rem, 2rem + 4vw, 5.25rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--green-800);
    font-variant-numeric: tabular-nums lining-nums;
  }
  .stats__label { color: var(--ink-muted); max-width: 18em; }

  @media (max-width: 859px) {
    .about__grid { grid-template-columns: 1fr; }
    .about__visual { justify-self: start; max-width: 520px; }
    .about__frame { border-bottom-left-radius: 96px; }
    .stats { grid-template-columns: 1fr; }
    .stats__item { border-left: 0; border-bottom: 1px solid var(--gray-100); padding: 1.5rem 0; flex-direction: row-reverse; align-items: baseline; justify-content: flex-end; gap: 1.25rem; }
    .stats__value { font-size: 3rem; min-width: 4ch; }
  }
</style>
