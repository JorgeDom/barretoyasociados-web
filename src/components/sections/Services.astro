---
import Icon from '../ui/Icon.astro';
import DotGrid from '../decor/DotGrid.astro';
import { services } from '../../data/site';
---
<section class="section services" id="servicios" aria-labelledby="services-title">
  <div class="container services__grid">
    <div class="services__head">
      <div class="services__sticky">
        <h2 id="services-title" data-reveal>Servicios</h2>
        <p class="services__intro" data-reveal style="--i:1">{services.intro}</p>
        <DotGrid class="services__dots" cols={6} rows={4} />
      </div>
    </div>

    <ul class="services__list">
      {services.items.map((s, i) => (
        <li class="service" data-reveal style={`--i:${i % 3}`}>
          <Icon name={s.icon} size={52} class="service__icon" />
          <div class="service__body">
            <h3>{s.title}</h3>
            <p>{s.detail}</p>
            {s.tags.length > 0 && (
              <ul class="service__tags" aria-label="Instituciones y normativa">
                {s.tags.map((t) => <li class="tag">{t}</li>)}
              </ul>
            )}
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .services__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: start;
  }
  .services__sticky {
    position: sticky;
    top: calc(var(--nav-h) + 2.5rem);
    display: grid;
    gap: 1.5rem;
  }
  .services__intro { color: var(--ink-muted); max-width: 30em; }
  .services__sticky :global(.services__dots) { position: relative; z-index: 0; margin-top: 1rem; }

  .services__list { border-top: 1px solid var(--gray-100); }
  .service {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.5rem;
    padding: 2rem 0 2rem 0.25rem;
    border-bottom: 1px solid var(--gray-100);
  }
  .service::before {
    content: '';
    position: absolute;
    left: -1.25rem; top: 2rem; bottom: 2rem;
    width: 3px;
    border-radius: 3px;
    background: var(--green-500);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 350ms var(--ease-out);
  }
  .service:hover::before { transform: scaleY(1); }
  .service__body { display: grid; gap: 0.5rem; }
  .service h3 { font-size: var(--step-2); color: var(--ink); }
  .service p { color: var(--ink-muted); }
  .service__tags { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 0.5rem; }

  @media (max-width: 859px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__sticky { position: static; }
    :global(.services__dots) { display: none; }
    .service { gap: 1rem; }
    .service::before { display: none; }
    .service h3 { font-size: var(--step-1); }
  }
</style>
