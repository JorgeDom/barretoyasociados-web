---
import SectionHeading from './SectionHeading.astro';
import { team } from '../data/site';
---

<section id="equipo" class="relative pt-20 pb-2">
  <SectionHeading
    lead="Nuestro"
    highlight="equipo"
    text="Profesionales que respaldan cada operación con experiencia y compromiso."
    barClass="bg-accent"
    class="mb-14"
  />

  <ul class="relative z-1 m-0 grid list-none grid-cols-1 gap-x-10 gap-y-14 p-0 sm:grid-cols-2 lg:grid-cols-3 wide:grid-cols-6 wide:gap-x-6">
    {
      team.map((m) => (
        <li class="flex flex-col items-center transition-transform duration-250 hover:-translate-y-1">
          <div class="relative h-[200px] w-[200px]">
            <div class="hexagon absolute top-3.5 left-3.5 h-[200px] w-[200px] bg-mint" />
            <div class="hex-frame absolute inset-0 bg-white shadow-[0_10px_24px_rgba(0,0,0,0.12)]" />
            <div
              class="hexagon absolute inset-1.5 flex items-center justify-center bg-[linear-gradient(135deg,#E7F6EE,#F7FAF8)]"
              role="img"
              aria-label={`Foto de ${m.name}`}
            >
              <span class="text-[44px] font-extrabold tracking-wide text-brand/40">{m.initials}</span>
            </div>
          </div>
          <div class="z-1 -mt-7 flex w-full max-w-[280px]">
            <div class="name-banner flex min-h-16 flex-1 flex-col justify-center rounded-l-xl bg-[linear-gradient(135deg,#185F35,#124A29)] py-3.5 pr-[26px] pl-[18px]">
              <h3 class="m-0 text-sm leading-[1.3] font-bold text-white">{m.name}</h3>
              <p class="mt-0.5 mb-0 text-xs italic text-on-dark">{m.role}</p>
            </div>
            <div class="-ml-4 flex w-[78px] flex-none items-center justify-center rounded-r-xl bg-white shadow-[0_4px_14px_rgba(0,0,0,0.08)]">
              <div class="role-icon flex h-[52px] w-[52px] items-center justify-center rounded-full bg-accent/15 text-brand transition-colors duration-250">
                <span
                  class="icon-mask h-[26px] w-[26px] bg-current"
                  style={`-webkit-mask-image:url(${m.icon});mask-image:url(${m.icon})`}
                  aria-hidden="true"></span>
              </div>
            </div>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hex-frame {
    clip-path: polygon(25% 1%, 75% 1%, 99% 50%, 75% 99%, 25% 99%, 1% 50%);
  }
  .name-banner {
    clip-path: polygon(0 0, calc(100% - 22px) 0, 100% 50%, calc(100% - 22px) 100%, 0 100%);
  }
  .role-icon:hover {
    background: var(--color-accent);
    color: var(--color-ink);
  }
</style>
