---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  icon: string;
  iconLabel: string;
  image: ImageMetadata;
  size: 'large' | 'small';
  dark?: boolean;
  /** Max width of the text column, as a percentage of the card */
  textWidth: number;
  titleSize: number;
  subtitleClass?: string;
  centerHeading?: boolean;
}

const {
  href,
  title,
  subtitle,
  icon,
  iconLabel,
  image,
  size,
  dark = false,
  textWidth,
  titleSize,
  subtitleClass = 'text-[13.5px]',
  centerHeading = false,
} = Astro.props;
const large = size === 'large';
---

<a
  href={href}
  target="_blank"
  rel="noopener"
  class:list={[
    'service-card relative block overflow-hidden rounded-[28px] p-7 no-underline transition-[transform,box-shadow] duration-250 ease-out hover:-translate-y-1',
    large ? 'min-h-[280px] min-w-[300px] flex-[1_1_380px]' : 'min-h-[270px] min-w-[240px] flex-[1_1_260px]',
    dark ? 'is-dark bg-[linear-gradient(135deg,#185F35,#124A29)]' : 'bg-soft',
  ]}
>
  <div class="relative z-1 flex max-w-(--text-w) flex-col gap-4 max-[480px]:max-w-[75%]" style={`--text-w:${textWidth}%`}>
    <div class:list={['flex', large ? 'gap-3.5' : 'gap-3', centerHeading ? 'items-center' : 'items-start']}>
      <div
        class:list={[
          'flex flex-none items-center justify-center bg-white',
          large ? 'h-16 w-16 rounded-2xl' : 'h-[60px] w-[60px] rounded-[14px]',
          dark ? 'shadow-[0_4px_10px_rgba(0,0,0,0.12)]' : 'shadow-[0_4px_10px_rgba(0,0,0,0.06)]',
        ]}
      >
        <span
          class="icon-mask h-12 w-12"
          style={`-webkit-mask-image:url(${icon});mask-image:url(${icon})`}
          role="img"
          aria-label={iconLabel}></span>
      </div>
      <h3
        class:list={['m-0 font-extrabold', dark ? 'text-white' : 'text-ink', large && dark ? 'leading-[1.3]' : 'leading-[1.35]']}
        style={`font-size:${titleSize}px`}
        set:html={title}
      />
    </div>
    {subtitle && <p class:list={['m-0', subtitleClass, dark ? 'text-on-dark-muted' : 'text-muted']}>{subtitle}</p>}
  </div>

  <div
    class:list={[
      'absolute right-0',
      large ? 'fade-left top-0 h-full w-1/2' : 'fade-corner bottom-0 h-[78%] w-[66%]',
      dark && (large ? 'bg-white/14' : 'bg-white/12'),
    ]}
  >
    <Image src={image} alt="" widths={[320, 480, 720]} sizes="(max-width: 640px) 66vw, 400px" class="h-full w-full object-cover" />
  </div>
</a>

<style>
  .service-card {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  .service-card:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.14);
  }
  .service-card.is-dark {
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
  }
  .service-card.is-dark:hover {
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.18);
  }
  .service-card:focus-visible {
    outline: 3px solid var(--color-accent);
    outline-offset: 3px;
  }
  .fade-left {
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 55%);
    mask-image: linear-gradient(90deg, transparent, #000 55%);
  }
  .fade-corner {
    -webkit-mask-image: radial-gradient(ellipse farthest-side at 100% 100%, #000 55%, transparent 92%);
    mask-image: radial-gradient(ellipse farthest-side at 100% 100%, #000 55%, transparent 92%);
  }
</style>
