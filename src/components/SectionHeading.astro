---
/** Centered heading with a short accent bar: "Nuestros <servicios>" style. */
interface Props {
  lead: string;
  highlight: string;
  text: string;
  barClass: string;
  class?: string;
}

const { lead, highlight, text, barClass, class: className } = Astro.props;
---

<div class:list={['relative z-1 mx-auto max-w-[640px] text-center', className]}>
  <div class:list={['mx-auto mb-5 h-1 w-12 rounded-sm', barClass]}></div>
  <h2 class="m-0 text-[clamp(28px,4.6vw,42px)] leading-[1.15] font-extrabold text-ink">
    {lead} <span class="text-accent">{highlight}</span>
  </h2>
  <p class="mt-3.5 mb-0 text-[14.5px] text-muted">{text}</p>
</div>
