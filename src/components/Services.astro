---
import ServiceCard from './ServiceCard.astro';
import SectionHeading from './SectionHeading.astro';
import { waLink } from '../data/site';
import despacho from '../assets/services/despacho.png';
import asesoria from '../assets/services/asesoria.jpg';
import maquila from '../assets/services/maquila.jpg';
import incentivos from '../assets/services/incentivos.png';
import gestion from '../assets/services/gestion.png';

const wa = (svc: string) => waLink(`Hola, quisiera consultar sobre ${svc}.`);
---

<section id="servicios" class="relative overflow-hidden rounded-[28px] pt-16 pb-2">
  <SectionHeading
    lead="Nuestros"
    highlight="servicios"
    text="Soluciones aduaneras integrales para impulsar su negocio."
    barClass="bg-brand"
    class="mb-11"
  />

  <!-- On wide screens both rows merge into a single 5-card row -->
  <div class="wide:grid wide:grid-cols-[1.3fr_1.3fr_1fr_1fr_1fr] wide:gap-[22px]">
  <div class="relative z-1 mb-[22px] flex flex-wrap gap-[22px] wide:contents">
    <ServiceCard
      href={wa('Despacho de aduanas')}
      title="Despacho de<br>aduanas"
      subtitle="Importación y exportación."
      icon="/icons/transport.png"
      iconLabel="Buque de transporte"
      image={despacho}
      size="large"
      dark
      textWidth={58}
      titleSize={19}
      centerHeading
    />
    <ServiceCard
      href={wa('Asesoría en legislación y trámites aduaneros')}
      title="Asesoría en legislación y trámites aduaneros"
      subtitle="Cumplimiento de la normativa vigente."
      icon="/icons/file.png"
      iconLabel="Documento con sello de conformidad"
      image={asesoria}
      size="large"
      textWidth={60}
      titleSize={17}
    />
  </div>

  <div class="relative z-1 flex flex-wrap gap-[22px] wide:contents">
    <ServiceCard
      href={wa('Procesos de maquila y regímenes especiales')}
      title="Procesos de maquila y regímenes especiales"
      icon="/icons/production.png"
      iconLabel="Planta de producción"
      image={maquila}
      size="small"
      textWidth={62}
      titleSize={16}
    />
    <ServiceCard
      href={wa('Consultoría en incentivos fiscales (Ley 60/90)')}
      title="Consultoría en incentivos fiscales"
      subtitle="Ley 60/90"
      icon="/icons/budget.png"
      iconLabel="Reporte financiero con calculadora"
      image={incentivos}
      size="small"
      dark
      textWidth={62}
      titleSize={16}
    />
    <ServiceCard
      href={wa('Gestión ante instituciones públicas')}
      title="Gestión ante instituciones públicas"
      subtitle="DINAVISA, INAN, SENACSA y CNIME"
      subtitleClass="text-[12.5px] leading-[1.5]"
      icon="/icons/analysis.png"
      iconLabel="Documento en revisión"
      image={gestion}
      size="small"
      textWidth={64}
      titleSize={16}
    />
  </div>
  </div>
</section>
