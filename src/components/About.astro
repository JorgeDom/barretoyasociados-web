---
import Eyebrow from './Eyebrow.astro';
import { Image } from 'astro:assets';
import { aboutItems, valores, timeline } from '../data/site';
import quienesImg from '../assets/quienes-somos-barreto.png';
import misionImg from '../assets/mision-vision-barreto.png';
import valoresImg from '../assets/valores-barreto.png';
import edificioImg from '../assets/edificio-colon1.jpg';

// On wide screens the three blocks sit side by side, each stacked photo-on-top
const split =
  'grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] items-center gap-11 wide:grid-cols-1 wide:items-start wide:gap-8';
const photo = 'h-[360px] w-full rounded-[18px] wide:order-first';
const sizes = '(min-width: 1920px) 700px, (min-width: 700px) 50vw, 100vw';
---

<div class="wide:grid wide:grid-cols-3 wide:gap-11">
<!-- Quiénes somos (text left, photo right) -->
<section id="nosotros" class="pt-[76px] pb-2">
  <div class={split}>
    <div>
      <Eyebrow kicker="Como agencia" title="Quiénes somos" class="mb-4" />
      <p class="mt-0 mb-[26px] text-[15px] leading-[1.75] text-ink">
        Somos una agencia de despacho de aduanas con más de 40 años de experiencia, dedicada a brindar asesoría integral
        en operaciones de importación, exportación, maquila y regímenes especiales.
      </p>
      <ul class="m-0 flex list-none flex-col gap-5 p-0">
        {
          aboutItems.map((it) => (
            <li>
              <h3 class="m-0 mb-1 text-[14.5px] font-extrabold text-ink">{it.title}</h3>
              <p class="m-0 text-[13.5px] leading-[1.6] text-muted">{it.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>
    <Image
      src={quienesImg}
      alt="Equipo de la agencia revisando documentación de comercio exterior con vista al puerto"
      widths={[480, 720, 1080, 1448]}
      {sizes}
      class:list={[photo, 'object-cover']}
    />
  </div>
</section>

<!-- Misión & visión (photo left, text right) -->
<section id="mision" class="pt-[76px] pb-2">
  <div class={split}>
    <Image
      src={misionImg}
      alt="Puerto fluvial con contenedores y grúas al atardecer"
      widths={[480, 720, 1080, 1448]}
      {sizes}
      class:list={[photo, 'object-cover']}
    />
    <div>
      <Eyebrow kicker="Nuestra" title="Misión & visión" />
      <div class="flex flex-col gap-[22px]">
        <div>
          <h3 class="m-0 mb-1 text-[14.5px] font-extrabold text-ink">Misión</h3>
          <p class="m-0 text-[13.5px] leading-[1.65] text-muted">
            Brindar productos y servicios de calidad, ofreciendo soluciones eficientes y personalizadas, basadas en la
            confianza, el compromiso y la excelencia.
          </p>
        </div>
        <div>
          <h3 class="m-0 mb-1 text-[14.5px] font-extrabold text-ink">Visión</h3>
          <p class="m-0 text-[13.5px] leading-[1.65] text-muted">
            Ser una empresa líder y referente consolidado en el sector, reconocida por la calidad de sus servicios y la
            confianza de sus clientes.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Valores (items left, photo right) -->
<section class="pt-[76px] pb-2">
  <div class={split}>
    <div>
      <Eyebrow kicker="Nuestros" title="Valores" />
      <ol class="m-0 flex list-none flex-col gap-[18px] p-0">
        {
          valores.map((text, i) => (
            <li class="flex items-start gap-3.5">
              <span class="flex-none text-[15px] font-black text-accent">{String(i + 1).padStart(2, '0')}</span>
              <span class="text-[13.5px] leading-[1.6] text-ink">{text}</span>
            </li>
          ))
        }
      </ol>
    </div>
    <Image
      src={valoresImg}
      alt="Profesional de la agencia revisando documentación con vista al puerto y un buque portacontenedores"
      widths={[480, 720, 1122]}
      {sizes}
      class="h-[340px] w-full rounded-[18px] object-cover object-[center_55%] wide:order-first wide:h-[360px]"
    />
  </div>
</section>

</div>

<!-- Historia & trayectoria (timeline left, photo right) -->
<section id="historia" class="pt-[76px] pb-2">
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] items-start gap-11">
    <div>
      <Eyebrow kicker="Nuestra" title="Historia & trayectoria" class="mb-6" />
      <ol class="m-0 list-none p-0">
        {
          timeline.map((tl, i) => (
            <li class="flex gap-3.5">
              <div class="flex flex-none flex-col items-center">
                <span class="mt-1 h-3 w-3 flex-none rounded-full bg-accent" />
                {i < timeline.length - 1 && <div class="w-0.5 flex-1 bg-line" />}
              </div>
              <div class="pb-[26px]">
                <div class="text-[12.5px] font-extrabold tracking-[0.02em] text-brand uppercase">{tl.date}</div>
                <p class="mt-1 mb-0 text-sm leading-[1.6] text-ink">{tl.desc}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
    <Image
      src={edificioImg}
      alt="Foto histórica en blanco y negro del edificio Colón 1, sede de la primera oficina de la agencia"
      widths={[480, 720, 1080, 1536]}
      sizes="(min-width: 700px) 50vw, 100vw"
      class="h-[420px] w-full rounded-[18px] object-cover object-[center_55%]"
    />
  </div>
</section>
