---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import { contact } from '../data/site';

const columns = [
  {
    title: 'Servicios',
    links: [
      { label: 'Despacho de aduanas', href: '#servicios' },
      { label: 'Asesoría aduanera', href: '#servicios' },
      { label: 'Incentivos fiscales', href: '#servicios' },
      { label: 'Maquila', href: '#servicios' },
    ],
  },
  {
    title: 'Empresa',
    links: [
      { label: 'Quiénes somos', href: '#nosotros' },
      { label: 'Historia', href: '#historia' },
      { label: 'Equipo', href: '#equipo' },
      { label: 'Clientes', href: '#clientes' },
    ],
  },
];
const year = new Date().getFullYear();
---

<footer class="mt-[72px] bg-ink px-5 pt-12 pb-5">
  <div class="mx-auto max-w-[1240px] wide:max-w-[1760px] ultra:max-w-[2200px]">
    <div class="grid grid-cols-[repeat(auto-fit,minmax(180px,1fr))] gap-8">
      <div>
        <div class="mb-3 inline-block rounded-[10px] bg-white px-3.5 py-2.5">
          <Image src={logo} alt="Barreto T y Asociados S.A." height={48} class="block h-12 w-auto" />
        </div>
        <p class="mt-2 mb-0 max-w-[220px] text-[12.5px] leading-[1.6] text-[#B4B4B4]">
          Agencia de Despachos Aduaneros. 43 años acompañando el comercio exterior en Paraguay.
        </p>
      </div>
      {
        columns.map((col) => (
          <nav aria-label={col.title} class="flex flex-col gap-2.5">
            <h2 class="footer-title">{col.title}</h2>
            {col.links.map((l) => (
              <a href={l.href} class="footer-link">
                {l.label}
              </a>
            ))}
          </nav>
        ))
      }
      <div class="flex flex-col gap-2.5">
        <h2 class="footer-title">Contacto</h2>
        <a href={contact.phoneHref} class="footer-link">{contact.phone}</a>
        <a href={`mailto:${contact.email}`} class="footer-link break-all">{contact.email}</a>
        <span class="text-[13px] leading-normal text-line">{contact.addressShort}</span>
      </div>
    </div>
    <div
      class="mt-8 flex flex-wrap justify-between gap-2 border-t border-[#333] pt-6 pb-1 text-xs text-subtle"
    >
      <span>© <span id="footer-year">{year}</span> Barreto T y Asociados S.A. Todos los derechos reservados.</span>
    </div>
  </div>
</footer>

<style>
  .footer-title {
    margin: 0 0 4px;
    font-weight: 700;
    font-size: 12px;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .footer-link {
    color: var(--color-line);
    font-size: 13px;
    text-decoration: none;
  }
  .footer-link:hover {
    color: var(--color-accent);
  }
</style>

<script>
  // Keep the copyright year current without a rebuild
  document.getElementById('footer-year')!.textContent = String(new Date().getFullYear());
</script>
