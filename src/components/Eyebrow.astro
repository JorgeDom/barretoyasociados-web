---
/** Italic kicker + uppercase green title ("Nuestra / MISIÓN & VISIÓN"). */
interface Props {
  kicker: string;
  title: string;
  class?: string;
}

const { kicker, title, class: className = 'mb-[26px]' } = Astro.props;
---

<p class="mb-1.5 text-base font-medium italic text-accent">{kicker}</p>
<h2 class:list={['mt-0 text-[clamp(24px,4vw,34px)] font-extrabold uppercase text-brand', className]}>{title}</h2>
