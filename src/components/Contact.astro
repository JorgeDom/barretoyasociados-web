---
import Eyebrow from './Eyebrow.astro';
import { contact, WHATSAPP_NUMBER } from '../data/site';

const input =
  'w-full rounded-lg border-[1.5px] border-line px-3.5 py-3 font-[inherit] text-sm text-ink placeholder:text-subtle focus:border-accent';
const label = 'sr-only';
---

<section id="contacto" class="pt-[76px] pb-2">
  <div class="mx-auto mb-10 max-w-[640px] text-center">
    <Eyebrow kicker="Hablemos" title="Contacto" class="mb-0" />
  </div>
  <div class="grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-10 wide:grid-cols-[3fr_2fr]">
    <!-- Wide screens: details on the left, map fills the column beside them -->
    <div class="flex flex-col gap-[18px] wide:grid wide:grid-cols-2 wide:grid-rows-[auto_auto_auto_1fr] wide:gap-x-10">
      <a href={contact.mapsHref} target="_blank" rel="noopener" class="contact-item">
        <span class="contact-label">Ubicación</span>
        {contact.address}
      </a>
      <a href={contact.phoneHref} class="contact-item">
        <span class="contact-label">Teléfono</span>
        {contact.phone}
      </a>
      <a href={`mailto:${contact.email}`} class="contact-item break-all">
        <span class="contact-label">Correo</span>
        {contact.email}
      </a>
      <iframe
        title="Ubicación en el mapa"
        src={contact.mapsEmbed}
        class="mt-1.5 h-[200px] w-full rounded-xl border-0 wide:col-start-2 wide:row-span-4 wide:row-start-1 wide:mt-0 wide:h-full wide:min-h-[200px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>

    <form
      id="contact-form"
      data-wa={WHATSAPP_NUMBER}
      class="flex flex-col gap-3.5 rounded-[14px] border border-line bg-white p-[26px] max-sm:order-first"
      novalidate
    >
      <label for="cf-name" class={label}>Tu nombre</label>
      <input id="cf-name" name="name" type="text" placeholder="Tu nombre" autocomplete="name" required class={input} />
      <label for="cf-company" class={label}>Nombre de tu empresa</label>
      <input
        id="cf-company"
        name="company"
        type="text"
        placeholder="Nombre de tu empresa"
        autocomplete="organization"
        class={input}
      />
      <div class="grid grid-cols-[repeat(auto-fit,minmax(160px,1fr))] gap-3.5">
        <div>
          <label for="cf-email" class={label}>Correo electrónico</label>
          <input
            id="cf-email"
            name="email"
            type="email"
            placeholder="correo@empresa.com"
            autocomplete="email"
            class={input}
          />
        </div>
        <div>
          <label for="cf-phone" class={label}>Teléfono</label>
          <input id="cf-phone" name="phone" type="tel" placeholder="0981 000-000" autocomplete="tel" class={input} />
        </div>
      </div>
      <label for="cf-message" class={label}>Tu consulta</label>
      <textarea
        id="cf-message"
        name="message"
        rows="4"
        placeholder="Contanos tu consulta"
        required
        class:list={[input, 'resize-y']}></textarea>
      <p id="cf-error" class="m-0 hidden text-[13px] font-medium text-[#B42318]" role="alert"></p>
      <button
        type="submit"
        class="cursor-pointer rounded-[10px] border-none bg-brand px-6 py-3.5 text-[15px] font-bold text-white transition-colors hover:bg-brand-dark"
      >
        Enviar consulta
      </button>
      <p class="m-0 text-center text-xs text-subtle">Tu consulta se enviará por WhatsApp.</p>
    </form>
  </div>
</section>

<style>
  .contact-item {
    color: var(--color-ink);
    font-size: 14px;
    text-decoration: none;
  }
  .contact-item:hover {
    color: var(--color-brand);
  }
  .contact-label {
    display: block;
    margin-bottom: 4px;
    font-weight: 700;
    font-size: 11.5px;
    color: var(--color-accent);
    text-transform: uppercase;
    letter-spacing: 0.03em;
  }
  input:focus,
  textarea:focus {
    outline: none;
  }
  input:focus-visible,
  textarea:focus-visible {
    outline: 2.5px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const error = document.getElementById('cf-error')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const name = get('name');
    const message = get('message');

    if (!name || !message) {
      error.textContent = 'Por favor completá tu nombre y tu consulta.';
      error.classList.remove('hidden');
      (form.elements.namedItem(!name ? 'name' : 'message') as HTMLElement).focus();
      return;
    }
    error.classList.add('hidden');

    const lines = [
      `Hola, soy ${name}${get('company') ? ` de ${get('company')}` : ''}.`,
      '',
      message,
    ];
    const extra = [get('email') && `Correo: ${get('email')}`, get('phone') && `Teléfono: ${get('phone')}`].filter(Boolean);
    if (extra.length) lines.push('', ...extra);

    const url = `https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(lines.join('\n'))}`;
    window.open(url, '_blank', 'noopener');
  });
</script>
