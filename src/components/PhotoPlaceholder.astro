---
/**
 * Stand-in for a photo that hasn't been supplied yet.
 * Replace with <Image src={...} class="h-full w-full object-cover" /> once the real photo arrives.
 */
interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  class:list={[
    'relative flex items-center justify-center overflow-hidden bg-[linear-gradient(135deg,#E7F6EE,#F7FAF8)]',
    className,
  ]}
>
  <div class="absolute -top-10 -right-10 h-40 w-40 rounded-full border-2 border-accent/25"></div>
  <div class="absolute -bottom-12 -left-8 h-44 w-44 rounded-full bg-brand/5"></div>
  <svg
    width="56"
    height="56"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="relative text-brand/35"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
    <circle cx="8.5" cy="10" r="1.6"></circle>
    <path d="M21 16l-5-5-8 8"></path>
  </svg>
</div>
