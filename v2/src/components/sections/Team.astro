---
// Group photo plus a staff directory grouped by area, with each person's e-mail and phone.
import Media from '../ui/Media.astro';
import Glow from '../decor/Glow.astro';
import DotGrid from '../decor/DotGrid.astro';
import { teamAreas, teamIntro, teamPhoto } from '../../data/site';

// 595981221206 → +595 981 221 206
const formatPhone = (p: string) => `+${p.slice(0, 3)} ${p.slice(3, 6)} ${p.slice(6, 9)} ${p.slice(9)}`;
---
<section class="section team" id="equipo" aria-labelledby="team-title">
  <Glow class="team__glow" />
  <DotGrid class="team__dots" cols={8} rows={5} />
  <div class="container">
    <div class="section-head">
      <h2 id="team-title" data-reveal>Conozca al equipo</h2>
      <p class="lede" data-reveal style="--i:1">{teamIntro}</p>
    </div>

    <div class="team__photo" data-reveal="fade">
      <Media file={teamPhoto.file} alt={teamPhoto.alt} width={1600} height={900} />
    </div>

    <div class="team__areas">
      {teamAreas.map((area, a) => (
        <section class="area" aria-labelledby={`team-area-${a}`}>
          <div class="area__head" data-reveal>
            <h3 id={`team-area-${a}`}>{area.name}</h3>
            <p>{area.description}</p>
          </div>
          <ul class="area__people">
            {area.members.map((m, i) => (
              <li class="person" data-reveal style={`--i:${i % 2}`}>
                <h4>{m.name}</h4>
                <p class="person__role">{m.role}</p>
                <ul class="person__contact">
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6.5 8.5-6.5"/></svg>
                    <a href={`mailto:${m.email}`}>
                      <span class="visually-hidden">Correo de {m.name}: </span>{m.email.split('@')[0]}@<wbr />{m.email.split('@')[1]}
                    </a>
                  </li>
                  <li>
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.6 3.5 9 3l1.6 4-2 1.3a11 11 0 0 0 5.1 5.1l1.3-2 4 1.6-.5 2.4a2 2 0 0 1-2 1.6A15.5 15.5 0 0 1 5 5.5a2 2 0 0 1 1.6-2Z"/></svg>
                    <a href={`tel:+${m.phone}`}>
                      <span class="visually-hidden">Teléfono de {m.name}: </span>{formatPhone(m.phone)}
                    </a>
                  </li>
                </ul>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>
</section>

<style>
  .team { overflow: clip; }
  :global(.team__glow) { left: -220px; top: 30%; width: 640px; height: 640px; }
  :global(.team__dots) { right: max(1rem, calc(50% - 700px)); top: calc(var(--section-y) + 0.5rem); }

  .team__photo {
    overflow: hidden;
    border-radius: var(--radius-l) 120px var(--radius-l) var(--radius-l);
    background: var(--green-50);
  }

  .team__areas { margin-top: clamp(2.5rem, 5vw, 4rem); }
  .area {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding-block: clamp(2rem, 4vw, 3rem);
    border-top: 1px solid var(--gray-100);
  }
  .area:last-child { padding-bottom: 0; }
  .area__head { display: grid; gap: 0.6rem; }
  .area__head h3 { font-size: var(--step-2); line-height: 1.2; }
  .area__head p { color: var(--ink-muted); max-width: 26em; }

  .area__people {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .person {
    display: grid;
    align-content: start;
    padding: 1.35rem 1.5rem 1.1rem;
    background: var(--white);
    border: 1px solid var(--gray-100);
    border-radius: var(--radius-m);
  }
  .person h4 { font-size: 1.125rem; line-height: 1.3; letter-spacing: -0.01em; color: var(--ink); }
  .person__role { margin-top: 0.15rem; color: var(--green-800); font-weight: 500; }
  .person__contact {
    display: grid;
    margin-top: 1rem;
    padding-top: 0.6rem;
    border-top: 1px solid var(--gray-100);
  }
  .person__contact li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 0.65rem; align-items: center; }
  .person__contact svg {
    width: 20px; height: 20px;
    fill: none; stroke: var(--green-800); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round;
  }
  .person__contact a {
    padding-block: 0.4rem;
    color: var(--ink);
    font-size: 0.95rem;
    text-decoration: none;
    overflow-wrap: anywhere;
    font-variant-numeric: lining-nums;
  }
  .person__contact a:hover { color: var(--green-800); text-decoration: underline; }

  @media (max-width: 959px) {
    :global(.team__dots) { display: none; }
    .area { grid-template-columns: 1fr; gap: 1.25rem; }
  }
  @media (max-width: 599px) {
    .team__photo { border-radius: var(--radius-m) 64px var(--radius-m) var(--radius-m); }
    .area__people { grid-template-columns: 1fr; }
  }
</style>
