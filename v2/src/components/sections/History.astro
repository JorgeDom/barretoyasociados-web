---
import Media from '../ui/Media.astro';
import DotGrid from '../decor/DotGrid.astro';
import YearsText from '../ui/YearsText.astro';
import { history } from '../../data/site';
---
<section class="section history" id="historia" aria-labelledby="history-title">
  <DotGrid class="history__dots" cols={7} rows={5} />
  <div class="container history__grid">
    <div class="history__aside">
      <div class="history__sticky">
        <h2 id="history-title" data-reveal>Historia y trayectoria</h2>
        <figure class="history__figure" data-reveal="fade" style="--i:1">
          <div class="history__photo">
            <Media file="historia-colon1.jpg" alt="Fotografía antigua en blanco y negro del edificio Colón 1 en Asunción" width={960} height={1200} />
          </div>
          <figcaption>Edificio Colón 1, Asunción. Aquí funcionó la primera oficina de la agencia, y aquí sigue hoy.</figcaption>
        </figure>
      </div>
    </div>

    <ol class="timeline" data-timeline>
      {history.map((h, i) => (
        <li class="timeline__item" data-reveal="left" style={`--i:${i === 0 ? 0 : 1}`}>
          <span class="timeline__marker" aria-hidden="true"></span>
          <p class="timeline__when">{h.when}</p>
          <h3><YearsText text={h.title} /></h3>
          <p class="timeline__text"><YearsText text={h.text} /></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .history { background: linear-gradient(to bottom, var(--white), var(--green-50) 30%, var(--green-50) 70%, var(--white)); }
  :global(.history__dots) { right: max(1rem, calc(50% - 700px)); bottom: 3rem; }
  .history__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .history__sticky { position: sticky; top: calc(var(--nav-h) + 2.5rem); display: grid; gap: 2rem; }
  .history__figure { margin: 0; display: grid; gap: 0.85rem; max-width: 400px; }
  .history__photo { border-radius: var(--radius-m); overflow: hidden; filter: grayscale(1); }
  .history__figure figcaption { font-size: var(--step--1); color: var(--ink-muted); max-width: 32em; }

  .timeline {
    --progress: 0;
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    padding: 0.5rem 0 0.5rem 3rem;
  }
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: 11px; top: 0.75rem; bottom: 0.75rem;
    width: 2px;
    background: var(--gray-100);
  }
  .timeline::after {
    background: var(--green-800);
    transform-origin: top;
    transform: scaleY(var(--progress));
  }
  .timeline__item { position: relative; display: grid; gap: 0.4rem; max-width: 34em; }
  .timeline__marker {
    position: absolute;
    left: -3rem; top: 0.2rem;
    width: 24px; height: 24px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--green-800);
    z-index: 1;
    transition: background-color 400ms ease 300ms, box-shadow 400ms ease 300ms;
  }
  .timeline__item:global(.is-visible) .timeline__marker,
  :global(html:not(.js)) .timeline__marker {
    background: var(--green-800);
    box-shadow: inset 0 0 0 4px var(--white);
  }
  .timeline__when { font-weight: 700; color: var(--green-800); font-variant-numeric: lining-nums; }
  .timeline h3 { font-size: var(--step-2); color: var(--ink); }
  .timeline__text { color: var(--ink-muted); }

  @media (prefers-reduced-motion: reduce) {
    .timeline::after { transform: none; }
    .timeline__marker { background: var(--green-800); box-shadow: inset 0 0 0 4px var(--white); }
  }
  @media (max-width: 859px) {
    :global(.history__dots) { display: none; }
    .history__grid { grid-template-columns: 1fr; }
    .history__sticky { position: static; }
    .history__figure { max-width: 320px; }
    .timeline h3 { font-size: var(--step-1); }
  }
</style>
