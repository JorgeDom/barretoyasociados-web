---
// Full-bleed photo band with parallax and the brand's service line (from the logo lockup).
import Media from '../ui/Media.astro';
const words = ['Importación.', 'Exportación.', 'Maquila.'];
---
<section class="band" aria-label="Importación, exportación y maquila">
  <div class="band__media" aria-hidden="true">
    <div class="band__media-inner" data-parallax-local="0.18">
      <Media file="band-port.jpg" alt="" width={2400} height={1000} />
    </div>
  </div>
  <div class="container band__content">
    <p class="band__line" aria-hidden="true">
      {words.map((w, i) => <span data-reveal style={`--i:${i * 2}`}>{w}</span>)}
    </p>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(320px, 62vh, 620px);
    display: grid;
    align-items: center;
    color: var(--white);
    background: var(--green-950);
  }
  .band__media { position: absolute; inset: 0; z-index: -2; }
  .band__media-inner { position: absolute; inset: -18% 0; will-change: transform; }
  .band__media-inner :global(.media) { width: 100%; height: 100%; object-fit: cover; aspect-ratio: auto !important; }
  .band__media-inner :global(.placeholder) { height: 100%; }
  .band::after {
    content: '';
    position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(100deg, rgb(14 58 32 / 0.88) 0%, rgb(14 58 32 / 0.55) 50%, rgb(14 58 32 / 0.15) 100%);
  }
  .band__line {
    display: flex; flex-wrap: wrap; gap: 0 0.35em;
    margin: 0;
    font-size: clamp(2.4rem, 1.2rem + 5.5vw, 5.75rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.02;
    max-width: 11ch;
  }
  .band__line span:nth-child(2) { color: var(--green-500); text-shadow: 0 2px 24px rgb(0 0 0 / 0.25); }
</style>
